/*
 * This is an example of a program in the comp25 language 
 */
program swap
begin 
    procedure swap(a: ref(int), b: ref(int))
    begin
        var tmp: int
    in
        tmp := deref(a);
        deref(a) := deref(b);
        deref(b) := tmp
    end;

    /// Testing swap procedure
    procedure main()
    begin
        var x: int;
        var y: int
    in
        x := 42;
        y := 84;

        print_string("Before swapping (x, y): ");
        print_int(x);
        print_string(" ");
        print_int(y);

        swap(ref(x), ref(y));

        print_string("\nAfter swapping (x, y): ");
        print_int(x);
        print_string(" ");
        print_int(y);
        print_string("\n")
    end
end

